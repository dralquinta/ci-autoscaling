#####################################
# DEFAULT: Replace with your application
#####################################
FROM alpine:latest
WORKDIR /app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Add your application files from the application-source-code directory
COPY application-source-code/ .

USER appuser
EXPOSE 8080

# Configure health check for your application
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Replace with your application start command
CMD ["echo", "Replace this with your application start command"]
