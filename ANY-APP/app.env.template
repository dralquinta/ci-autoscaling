# ========================================
# ANY-APP: Generic OCI Container Instance Deployment Configuration
# ========================================
# Copy this file to app.env and fill in your values
# Usage: source app.env
# Then run: ./deploy.sh --deploy

# ========================================
# REQUIRED: OCI Configuration
# ========================================
export OCI_COMPARTMENT_OCID="ocid1.compartment.oc1..aaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export SUBNET_OCID="ocid1.subnet.oc1.region.aaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export AD_NAME="YourRegion-AD-1"  # Example: US-ASHBURN-AD-1

# ========================================
# Docker Registry Configuration
# ========================================
export DOCKER_USERNAME="your-docker-username"
export DOCKER_PASSWORD=""  # Set this or use 'docker login' before deployment
export DOCKER_REGISTRY="docker.io"  # Options: docker.io, ghcr.io, or OCI Registry URL
export IMAGE_NAME="your-app-name"
export IMAGE_TAG="latest"

# ========================================
# Application Configuration
# ========================================
export CONTAINER_NAME="your-app"
export DISPLAY_NAME="your-app-instance"
export APP_PORT="8080"  # Your application's listening port
export HEALTH_CHECK_PATH="/health"  # Health check endpoint path
export APP_ENV="production"  # Application environment

# ========================================
# Container Resources
# ========================================
export MEMORY_GB="8"  # Memory in GB (min: 1, max: 64)
export OCPUS="1"      # OCPUs (min: 1, max: 64)

# ========================================
# Load Balancer Configuration
# ========================================
# If using an existing load balancer, set LB_OCID
export LB_OCID=""  # Leave empty to skip load balancer integration
export LB_SUBNET_OCID="${SUBNET_OCID}"  # Usually same as SUBNET_OCID
export LB_DISPLAY_NAME="your-app-lb"
export LB_SHAPE="flexible"  # Options: flexible, 100Mbps, 400Mbps, 8000Mbps
export LB_MIN_BANDWIDTH_MBPS="10"
export LB_MAX_BANDWIDTH_MBPS="100"
export BACKEND_SET_NAME="your-app-backend-set"
export LISTENER_NAME="http-listener-80"

# ========================================
# Advanced Configuration (Optional)
# ========================================
export INSTANCE_WAIT_TIMEOUT="300"  # Seconds to wait for instance to be active

# Application-specific environment variables
# Add your custom variables below and reference them in deploy.sh
# export DATABASE_URL="your-database-url"
# export API_KEY="your-api-key"
# export REDIS_HOST="your-redis-host"
