# ========================================
# ANY-APP: Generic OCI Container Instances Autoscaling Configuration
# ========================================
# Copy this file to autoscaling.env and fill in your values
# Usage: source autoscaling.env
# Then run: ./setup-autoscaling.sh --deploy

# ========================================
# REQUIRED: OCI Configuration (from app.env)
# ========================================
export COMPARTMENT_OCID="${OCI_COMPARTMENT_OCID}"
export SUBNET_OCID="${SUBNET_OCID}"
export AD_NAME="${AD_NAME}"

# ========================================
# Container Configuration
# ========================================
export IMAGE_URI="${DOCKER_REGISTRY}/${DOCKER_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG}"
export CONTAINER_NAME="${CONTAINER_NAME}"
export DISPLAY_NAME_PREFIX="${DISPLAY_NAME}"  # Instances will be named: prefix-1, prefix-2, etc.
export MEMORY_GB="${MEMORY_GB}"
export OCPUS="${OCPUS}"
export APP_PORT="${APP_PORT}"
export HEALTH_CHECK_PATH="${HEALTH_CHECK_PATH}"

# ========================================
# Load Balancer Configuration
# ========================================
export LB_OCID="${LB_OCID}"  # Required for autoscaling
export BACKEND_SET_NAME="${BACKEND_SET_NAME}"

# ========================================
# Autoscaling Limits
# ========================================
export MIN_INSTANCES="1"   # Minimum number of container instances
export MAX_INSTANCES="5"   # Maximum number of container instances

# ========================================
# Autoscaling Thresholds
# ========================================
# CPU Thresholds (percentage)
export CPU_SCALE_UP_THRESHOLD="70"      # Scale up when CPU > 70%
export CPU_SCALE_DOWN_THRESHOLD="30"    # Scale down when CPU < 30%

# Memory Thresholds (percentage)
export MEMORY_SCALE_UP_THRESHOLD="70"   # Scale up when Memory > 70%
export MEMORY_SCALE_DOWN_THRESHOLD="30" # Scale down when Memory < 30%

# ========================================
# Alarm Configuration
# ========================================
export ALARM_EVALUATION_PERIOD="5"      # Minutes to evaluate metric
export ALARM_FREQUENCY="1"              # Minutes between alarm checks

# ========================================
# Functions Configuration
# ========================================
export FUNCTIONS_APP_NAME="ci-autoscaling-any-app"
export SCALE_UP_FUNCTION_NAME="scale-up-any-app"
export SCALE_DOWN_FUNCTION_NAME="scale-down-any-app"

# VCN/Subnet for Functions (can be same as container subnet)
export FUNCTIONS_SUBNET_OCID="${SUBNET_OCID}"

# ========================================
# Notification Topic
# ========================================
export NOTIFICATION_TOPIC_NAME="ci-autoscaling-any-app-notifications"
export NOTIFICATION_EMAIL=""  # Optional: email for notifications

# ========================================
# Resource Tags (optional)
# ========================================
export RESOURCE_TAG_NAMESPACE="autoscaling"
export RESOURCE_TAG_KEY="managed-by"
export RESOURCE_TAG_VALUE="ci-autoscaling-any-app"

# ========================================
# Advanced Configuration
# ========================================
export COOLDOWN_PERIOD="120"  # Seconds between scale operations
export INSTANCE_CREATION_TIMEOUT="300"  # Seconds to wait for instance creation
